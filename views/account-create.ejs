<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Git Demo - Crear cuenta</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="assets/git-demo.css" rel="stylesheet">
</head>
<body>
  <main class="container-xl py-5">
    <div class="row justify-content-center">
      <section class="col-md-7 col-lg-5">
        <div class="text-center mb-4">
          <span class="brand-mark mx-auto mb-3"><i class="bi bi-git"></i></span>
          <h1 class="h3 mb-1">Crear cuenta</h1>
          <p class="muted mb-0">Una cuenta identifica tus commits, issues y revisiones dentro del equipo.</p>
        </div>
        <form class="form-shell p-4" method="POST" action="/register">
          <div class="mb-3">
            <label class="form-label fw-semibold" for="name">Nombre completo</label>
            <input class="form-control" id="name" placeholder="Ana Rodriguez" name="fullname" value="<%= old('fullname') %>">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold" for="username">Usuario</label>
            <div class="input-group">
              <span class="input-group-text">@</span>
              <input class="form-control" id="username" placeholder="ana-dev" name="username" value="<%= old('username') %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold" for="email">Email</label>
            <input class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" type="email" placeholder="ana@example.com" name="email" value="<%= old('email') %>">
            <% if (errors.email) { %>
              <div class="invalid-feedback">
                <%= errors.email.msg %>
              </div>
            <% } %>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold" for="password">Contrasena</label>
            <input class="form-control <%= errors.password ? 'is-invalid' : '' %>" id="password" type="password" placeholder="Minimo 8 caracteres" name="password">
            <% if (errors.password) { %>
              <div class="invalid-feedback">
                <%= errors.password.msg %>
              </div>
            <% } %>
          </div>
          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="terms" name="agree" <%= old('agree') ? 'checked' : '' %>>
            <label class="form-check-label small" for="terms">Acepto las reglas de colaboracion del proyecto.</label>
          </div>
          <button class="btn btn-success w-100"><i class="bi bi-person-plus me-1"></i>Crear cuenta</button>
        </form>
        <p class="text-center small mt-3 mb-0">Ya tienes cuenta? <a class="linkish" href="/login">Ingresar</a></p>
      </section>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
