<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Git Demo - Cambiar password</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="assets/git-demo.css" rel="stylesheet">
</head>
<body>
  <nav class="topbar navbar navbar-expand-lg">
    <div class="container-xl">
      <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="repository.html"><span class="brand-mark"><i class="bi bi-git"></i></span>Git Demo</a>
      <div class="ms-auto"><a class="btn btn-outline-secondary btn-sm" href="user-profile.html"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
    </div>
  </nav>

  <main class="container-xl py-4">
    <div class="row justify-content-center">
      <section class="col-lg-7">
        <div class="mb-3">
          <h1 class="h3 mb-1">Cambiar password</h1>
          <p class="muted mb-0">Protege tu cuenta con una clave fuerte para evitar accesos no autorizados al codigo.</p>
        </div>

        <form class="form-shell p-4">
          <div class="mb-3">
            <label class="form-label fw-semibold" for="oldPassword">Password actual</label>
            <input class="form-control" id="oldPassword" type="password" placeholder="Password actual">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold" for="newPassword">Nuevo password</label>
            <input class="form-control" id="newPassword" type="password" placeholder="Minimo 8 caracteres">
            <div class="form-text">Usa mayusculas, minusculas, numeros y un simbolo.</div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold" for="repeatPassword">Repetir nuevo password</label>
            <input class="form-control" id="repeatPassword" type="password" placeholder="Repite el password">
          </div>

          <div class="panel p-3 mb-4">
            <div class="small fw-semibold mb-2">Requisitos recomendados</div>
            <div class="row g-2 small muted">
              <div class="col-sm-6"><i class="bi bi-check-circle text-success me-1"></i>8 caracteres o mas</div>
              <div class="col-sm-6"><i class="bi bi-check-circle text-success me-1"></i>Una letra mayuscula</div>
              <div class="col-sm-6"><i class="bi bi-check-circle text-success me-1"></i>Un numero</div>
              <div class="col-sm-6"><i class="bi bi-check-circle text-success me-1"></i>Un simbolo</div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" href="user-profile.html">Cancelar</a>
            <button class="btn btn-success" type="button"><i class="bi bi-shield-lock me-1"></i>Actualizar password</button>
          </div>
        </form>
      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
