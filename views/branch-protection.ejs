<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Git Demo - Branch protection</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>

<body>
    <nav class="topbar navbar">
        <div class="container-xl">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="repository-settings.html">
                <span class="brand-mark"><i class="bi bi-git"></i></span>Git Demo
            </a>
        </div>
    </nav>
    <main class="container-xl py-4">
        <h1 class="h3">Branch protection</h1>
        <p class="muted">Reglas para proteger <code>main</code> antes de aceptar cambios.</p>

        <!-- Bloque de alerta superior si existen errores -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="alert alert-danger" role="alert">
                <ul class="mb-0">
                    <% errors.forEach(error => { %>
                        <li><%= error.msg %></li>                        
                    <% }) %>
                </ul>
            </div>
        <% } %>  

        <form class="form-shell p-4" method="POST" action="/branchprotection">
            
            <label class="form-label fw-semibold">Branch pattern</label>
            <!-- Mantiene el valor enviado o por defecto 'main' -->
            <!-- valores se define en el render como undefined y sino se le paso los valores en el update-->
            <input 
                class="form-control <%= errors.pattern ? 'is-invalid' : '' %>"            
                value="main"
                id="pattern" 
                name="pattern"
                placeholder="main, release y otros..." name="pattern" value="<%= old('pattern') %>"
                >
                <% if (errors.pattern) { %>
                <div class="invalid-feedback">
                    <%= errors.pattern.msg %>
                </div>
                <% } %>

            <div class="form-check mb-2 mt-3">
                <input class="form-check-input" checked type="checkbox" 
                id="reviews" 
                name="reviews"
                class="form-check-input <%= errors.reviews ? 'is-invalid' : '' %>"                           
                value="true"
                <%= (old('reviews') === 'true' || old('reviews') === 'on' || old('reviews') === true) ? 'checked' : '' %>                  
                >
                <% if (errors.reviews) { %>
                <div class="invalid-feedback">
                    <%= errors.reviews.msg %>
                </div>
                <% } %>

                <label class="form-check-label" for="reviews">Require pull request reviews before merging</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" checked type="checkbox" id="checks" name="checks">
                <label class="form-check-label" for="checks">Require status checks to pass</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="force" name="force">                
                <label class="form-check-label" for="force">Block force pushes</label>
            </div>
            <label class="form-label fw-semibold">Required approvals</label>
            <input class="form-control mb-4" 
                  type="number"
                  id="approvals"
                  name="approvals" 
                  min="0"
                  step="1"
                  value="<%= typeof valores !== 'undefined' ? valores.approvals : '1' %>">

                  <% if (typeof errors !== 'undefined' && errors.approvals) { %>
                    <div class="invalid-feedback">
                        <%= errors.approvals.msg %>
                    </div>
                  <% } %>

            <button class="btn btn-success" type="submit">Guardar regla</button>
            
        </form>
    </main>
</body>

</html>
